 /// Map an input-path error to a tool error, attaching the structured
 /// foreground `code` (`foreground_unavailable` / `foreground_timeout`) when the
 /// message carries one so the caller can branch instead of parsing prose.
+/// Project an unknown write without no-send claims or foreground/retry advice.
+fn text_write_uncertainty_result(error: &anyhow::Error) -> Option<ToolResult> {
+    crate::atspi::native::is_text_write_uncertain(error).then(|| {
+        ToolResult::error(error.to_string()).with_structured(json!({
+            "code": "text_write_uncertain",
+            "effect": "unknown",
+            "dispatched": null,
+            "retryable": false,
+            "verified": false,
+        }))
+    })
+}
+
+/// A panicked/cancelled blocking writer also cannot prove that nothing landed.
+fn stop_uncertain_text_attempt<T>(
+    attempt: &Result<anyhow::Result<T>, tokio::task::JoinError>,
+) -> Option<ToolResult> {
+    match attempt {
+        Ok(Err(error)) => text_write_uncertainty_result(error),
+        Err(_) => text_write_uncertainty_result(&crate::atspi::native::uncertain_text_write("AT-SPI worker")),
+        _ => None,
+    }
+}
