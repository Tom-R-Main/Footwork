+/// A mutation was awaited without a trustworthy acknowledgement. Never treat
+/// this as a proven no-send or as permission to try a second actuator.
+#[derive(Debug)]
+pub struct TextWriteUncertain {
+    operation: &'static str,
+    source: Option<zbus::Error>,
+}
+
+impl std::fmt::Display for TextWriteUncertain {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "text_write_uncertain: {} acknowledgement unavailable; delivery unknown", self.operation)
+    }
+}
+
+impl std::error::Error for TextWriteUncertain {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        self.source.as_ref().map(|error| error as &(dyn std::error::Error + 'static))
+    }
+}
+
+pub fn is_text_write_uncertain(error: &anyhow::Error) -> bool {
+    error.is::<TextWriteUncertain>()
+}
+
+/// A write-owner deadline can expire after sending. Without delivery proof,
+/// conservatively keep uncertainty even if the timeout actually preceded send.
+pub(crate) fn uncertain_text_write(operation: &'static str) -> anyhow::Error {
+    TextWriteUncertain { operation, source: None }.into()
+}
+
+fn text_write_ack(operation: &'static str, reply: zbus::Result<bool>) -> Result<bool> {
+    reply.map_err(|source| TextWriteUncertain { operation, source: Some(source) }.into())
+}
