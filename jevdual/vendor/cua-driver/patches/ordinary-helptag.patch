+fn ordinary_front_candidates(
+    windows: Vec<WindowInfo>,
+    evidence: &[HelpTagWindowEvidence],
+    pid: i32,
+    target: u32,
+    focused: Option<u32>,
+) -> Vec<WindowInfo> {
+    if focused != Some(target) {
+        return windows;
+    }
+    windows
+        .into_iter()
+        .filter(|window| {
+            if window.pid != pid || window.window_id == target {
+                return true;
+            }
+            let mut matches = evidence
+                .iter()
+                .filter(|proof| proof.window_id == window.window_id);
+            let Some(proof) = matches.next() else {
+                return true;
+            };
+            if matches.next().is_some() {
+                return true;
+            }
+            !(proof.owner_pid == Some(pid)
+                && proof.role.as_deref() == Some("AXHelpTag")
+                && proof.focused == Some(false)
+                && proof.focus_settable == Some(false)
+                && proof
+                    .actions
+                    .as_ref()
+                    .is_some_and(|actions| actions.iter().all(|action| action == "AXRaise")))
+        })
+        .collect()
+}
+
+fn target_is_help_tag(evidence: &[HelpTagWindowEvidence], pid: i32, target: u32) -> bool {
+    evidence.iter().any(|proof| {
+        proof.window_id == target
+            && proof.owner_pid == Some(pid)
+            && proof.role.as_deref() == Some("AXHelpTag")
+    })
+}
