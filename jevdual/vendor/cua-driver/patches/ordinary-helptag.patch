+/// Checked facts for an exact top-level AX counterpart; None is unknown.
+#[derive(Clone, Debug)]
+pub(crate) struct HelpTagWindowEvidence {
+    pub window_id: u32,
+    pub owner_pid: Option<i32>,
+    pub role: Option<String>,
+    pub actions: Option<Vec<String>>,
+    pub focused: Option<bool>,
+    pub focus_settable: Option<bool>,
+}
+
+/// Decode a successful typed action array. Errors/invalid contents are unknown, never empty.
+unsafe fn checked_action_array(error: AXError, names: CFArrayRef) -> Option<Vec<String>> {
+    use core_foundation::{array::CFArray, base::TCFType, string::CFString};
+    if error != kAXErrorSuccess
+        || names.is_null()
+        || core_foundation::base::CFGetTypeID(names as CFTypeRef) != CFArray::<CFTypeRef>::type_id()
+    {
+        return None;
+    }
+    let array = CFArray::<CFTypeRef>::wrap_under_get_rule(names);
+    if array.len() > 16 {
+        return None;
+    }
+    let mut result = Vec::new();
+    for item in array.iter() {
+        if core_foundation::base::CFGetTypeID(*item) != CFString::type_id() {
+            return None;
+        }
+        result.push(CFString::wrap_under_get_rule(*item as _).to_string());
+    }
+    Some(result)
+}
+
+fn checked_help_tag_settable(error: AXError, settable: u8) -> Option<bool> {
+    if error == kAXErrorSuccess && settable <= 1 {
+        Some(settable == 1)
+    } else {
+        None
+    }
+}
+
+/// Bounded read-only exact-ID census. A failed/incomplete census supplies no exclusions.
+/// Array ownership keeps every inspected AX element alive until its evidence is copied.
+pub(crate) fn help_tag_window_evidence(
+    pid: i32,
+    ids: &[u32],
+) -> Option<Vec<HelpTagWindowEvidence>> {
+    use core_foundation::{array::CFArray, base::TCFType};
+    use std::time::{Duration, Instant};
+    if ids.len() > 64 {
+        return None;
+    }
+    let deadline = Instant::now() + Duration::from_millis(100);
+    // SAFETY: created app and copied arrays are released on every path; element types are
+    // checked before AX calls and retained by the live array. All operations below are reads.
+    unsafe {
+        let app = AXUIElementCreateApplication(pid);
+        if app.is_null() {
+            return None;
+        }
+        if AXUIElementSetMessagingTimeout(app, 0.025) != kAXErrorSuccess {
+            CFRelease(app as CFTypeRef);
+            return None;
+        }
+        let attribute = CFStr::new("AXWindows");
+        let mut raw: CFTypeRef = std::ptr::null();
+        let error = AXUIElementCopyAttributeValue(app, attribute.as_concrete_TypeRef(), &mut raw);
+        CFRelease(app as CFTypeRef);
+        if error != kAXErrorSuccess || raw.is_null() {
+            if !raw.is_null() {
+                CFRelease(raw);
+            }
+            return None;
+        }
+        if core_foundation::base::CFGetTypeID(raw) != CFArray::<CFTypeRef>::type_id() {
+            CFRelease(raw);
+            return None;
+        }
+        let windows = CFArray::<CFTypeRef>::wrap_under_create_rule(raw as _);
+        if windows.len() > 64 {
+            return None;
+        }
+        let mut evidence = Vec::new();
+        for item in windows.iter() {
+            if Instant::now() >= deadline
+                || core_foundation::base::CFGetTypeID(*item) != AXUIElementGetTypeID()
+            {
+                return None;
+            }
+            let element = *item as AXUIElementRef;
+            if AXUIElementSetMessagingTimeout(element, 0.025) != kAXErrorSuccess {
+                return None;
+            }
+            let window_id = ax_get_window_id(element)?;
+            if !ids.contains(&window_id) {
+                continue;
+            }
+            let mut owner = 0;
+            let owner_pid =
+                (AXUIElementGetPid(element, &mut owner) == kAXErrorSuccess).then_some(owner);
+            let role = copy_string_attr(element, "AXRole");
+            let mut proof = HelpTagWindowEvidence {
+                window_id,
+                owner_pid,
+                role,
+                actions: None,
+                focused: None,
+                focus_settable: None,
+            };
+            if proof.owner_pid == Some(pid) && proof.role.as_deref() == Some("AXHelpTag") {
+                if Instant::now() >= deadline {
+                    return None;
+                }
+                let mut actions: CFArrayRef = std::ptr::null_mut();
+                let error = AXUIElementCopyActionNames(element, &mut actions);
+                proof.actions = checked_action_array(error, actions);
+                if !actions.is_null() {
+                    CFRelease(actions as CFTypeRef);
+                }
+                if Instant::now() >= deadline {
+                    return None;
+                }
+                proof.focused = copy_binary_attr(element, "AXFocused");
+                if Instant::now() >= deadline {
+                    return None;
+                }
+                let focused_attribute = CFStr::new("AXFocused");
+                let mut settable = 0_u8;
+                let error = AXUIElementIsAttributeSettable(
+                    element,
+                    focused_attribute.as_concrete_TypeRef(),
+                    &mut settable,
+                );
+                proof.focus_settable = checked_help_tag_settable(error, settable);
+            }
+            evidence.push(proof);
+        }
+        if Instant::now() >= deadline {
+            return None;
+        }
+        Some(evidence)
+    }
+}
