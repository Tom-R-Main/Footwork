+    let resolved = &recorded_calls(&f, "DOM.resolveNode")[resolved_before..];
+    assert_eq!(resolved.len(), 1, "{resolved:?}");
+    assert_eq!(resolved[0].1["executionContextId"], ISOLATED_CONTEXT);
+    let functions = &located_objects(&f)[functions_before..];
+    assert_eq!(
+        functions.len(),
+        2,
+        "the connected check and the locate: {functions:?}"
