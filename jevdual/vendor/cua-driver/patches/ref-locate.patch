+/// A `{x, y}` argument of finite numbers, `None` when absent.
+fn point_arg(args: &Value, field: &str) -> Result<Option<(f64, f64)>, ToolResult> {
+    match args.get(field) {
+        None | Some(Value::Null) => Ok(None),
+        Some(point) => {
+            let read = |axis: &str| {
+                point
+                    .get(axis)
+                    .and_then(Value::as_f64)
+                    .filter(|n| n.is_finite())
+            };
+            match (read("x"), read("y")) {
+                (Some(x), Some(y)) => Ok(Some((x, y))),
+                _ => Err(ToolResult::error(format!(
+                    "Field {field} has wrong type: expected an object with finite numbers x and y"
+                ))),
+            }
+        }
+    }
+}
