+#[tokio::test]
+async fn filmed_click_runs_wholly_in_the_isolated_world_and_scrolls_nothing() {
+    let f = fixture().await;
+    let (target, tab) = bind(&f).await;
+    let snap = snapshot(&f, &target, &tab).await;
+    let main_ref = ref_of(&snap, "main", "main-btn");
+    let functions_before = recorded_calls(&f, "Runtime.callFunctionOn").len();
+    let resolved_before = recorded_calls(&f, "DOM.resolveNode").len();
+
+    let result = filmed_click(&f, &target, &tab, &main_ref, json!({})).await;
+
+    assert_ne!(result.is_error, Some(true), "{}", result_text(&result));
+    assert!(result_text(&result).contains("dispatched synthetic DOM click"));
+    assert_eq!(
+        recorded_calls(&f, "Page.createIsolatedWorld")[0].1,
+        json!({ "frameId": "F_MAIN", "worldName": "cua-driver-locate" })
+    );
+    let resolved = &recorded_calls(&f, "DOM.resolveNode")[resolved_before..];
+    assert_eq!(resolved.len(), 1, "{resolved:?}");
+    assert_eq!(resolved[0].1["executionContextId"], ISOLATED_CONTEXT);
+    let functions = functions_since(&f, functions_before);
+    assert!(
+        functions.len() >= 3,
+        "the connected check, the baseline and the sequence: {functions:?}"
+    );
+    assert!(
+        functions
+            .iter()
+            .all(|(object, _, _)| object.starts_with("iso77-obj-")),
+        "nothing runs on a page-world object, before the click or after: {functions:?}"
+    );
+    let sequence: Vec<_> = functions
+        .iter()
+        .filter(|(_, declaration, _)| declaration.contains("'pointerdown'"))
+        .collect();
+    assert_eq!(sequence.len(), 1);
+    assert_eq!(
+        sequence[0].2,
+        json!([{ "value": 104.5 }, { "value": 105.0 }]),
+        "the sequence is given the pointer's position"
+    );
+    assert!(sequence[0].1.contains("'not_under_pointer'"));
+    assert!(
+        recorded_calls(&f, "DOM.scrollIntoViewIfNeeded").is_empty(),
+        "a scroll would move the node from under the pointer"
+    );
+    assert!(
+        recorded_calls(&f, "DOM.getBoxModel").is_empty(),
+        "no cursor is drawn"
+    );
+    assert!(recorded_calls(&f, "DOM.focus").is_empty());
     assert!(recorded_calls(&f, "Input.dispatchMouseEvent").is_empty());
