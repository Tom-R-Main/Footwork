+fn sent_any_event(f: &Fixture) -> bool {
+    recorded_calls(f, "Runtime.callFunctionOn")
+        .iter()
+        .filter_map(|(_, params)| params["functionDeclaration"].as_str().map(str::to_owned))
+        .any(|declaration| declaration.contains("'pointerdown'"))
+        || !recorded_calls(f, "Input.dispatchMouseEvent").is_empty()
+}
