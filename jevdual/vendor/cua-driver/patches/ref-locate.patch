+/// The execution context of the isolated world ([`LOCATE_WORLD`]) in the
+/// session's main frame, or `None` when the frame or the world could not be
+/// had. The world shares the page's DOM and none of its script objects.
+async fn isolated_world(conn: &CdpConnection, cdp: &str) -> Option<i64> {
+    let frame_tree = conn
+        .call(Some(cdp), "Page.getFrameTree", json!({}))
+        .await
+        .ok()?;
+    let frame = frame_tree.pointer("/frameTree/frame/id")?.as_str()?;
+    conn.call(
+        Some(cdp),
+        "Page.createIsolatedWorld",
+        json!({ "frameId": frame, "worldName": LOCATE_WORLD }),
+    )
+    .await
+    .ok()?
+    .get("executionContextId")?
+    .as_i64()
+}
