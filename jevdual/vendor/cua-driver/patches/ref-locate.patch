+}
+
+/// Where the ref's node is, evaluated ON the node with the click sequence's
+/// own geometry: its bounding rectangle in viewport CSS px and what
+/// `elementFromPoint` finds at its centre.
+const DOM_NODE_LOCATE: &str = "function() { \
+    const node = this; \
+    const r = node.getBoundingClientRect(); \
+    const x = r.left + r.width / 2, y = r.top + r.height / 2; \
+    const root = node.getRootNode(); \
+    const at = ('elementFromPoint' in root) ? root.elementFromPoint(x, y) : null; \
+    const hit = !at ? 'none' : (at === node ? 'target' : (node.contains(at) ? 'descendant' : 'other')); \
+    const view = node.ownerDocument.defaultView; \
+    return { rect: [r.left, r.top, r.width, r.height], hit, inner: [view.innerWidth, view.innerHeight] }; \
+}";
+
+/// The `locate` block of a `locate_only` click from the locate script's
+/// reply, the box model's centre and the layout metrics. Anything but a
+/// well-formed reply with a positive-area rectangle is unavailable; the
+/// box-model centre and the viewport's zoom and scale are `null` when they
+/// could not be read, for the caller to refuse on.
+fn dom_locate_value(
+    located: Option<&Value>,
+    box_center: Option<(f64, f64)>,
+    metrics: Option<&Value>,
+) -> Value {
+    let unavailable = |reason: &str| json!({ "available": false, "reason": reason });
+    let Some(reply) = located else {
+        return unavailable("unreadable");
+    };
+    if reply.get("exceptionDetails").is_some() {
+        return unavailable("unreadable");
+    }
+    let Some(value) = reply.pointer("/result/value") else {
+        return unavailable("unreadable");
+    };
+    let numbers = |field: &str, len: usize| -> Option<Vec<f64>> {
+        let items = value.get(field)?.as_array()?;
+        let numbers: Vec<f64> = items
+            .iter()
+            .filter_map(Value::as_f64)
+            .filter(|n| n.is_finite())
+            .collect();
+        (items.len() == len && numbers.len() == len).then_some(numbers)
+    };
+    let Some(rect) = numbers("rect", 4) else {
+        return unavailable("unreadable");
+    };
+    let hit = match value.get("hit").and_then(Value::as_str) {
+        Some(hit @ ("target" | "descendant" | "other" | "none")) => hit,
+        _ => return unavailable("unreadable"),
+    };
+    if rect[2] <= 0.0 || rect[3] <= 0.0 {
+        return unavailable("no_box");
+    }
+    let inner = numbers("inner", 2);
+    let viewport = metrics.and_then(|m| m.get("cssVisualViewport"));
+    let factor = |field: &str| {
+        viewport
+            .and_then(|v| v.get(field))
+            .and_then(Value::as_f64)
+            .filter(|n| n.is_finite())
+    };
+    json!({
+        "available": true,
+        "rect": { "x": rect[0], "y": rect[1], "width": rect[2], "height": rect[3] },
+        "center": { "x": rect[0] + rect[2] / 2.0, "y": rect[1] + rect[3] / 2.0 },
+        "hit": hit,
+        "box_center": box_center.map(|(x, y)| json!({ "x": x, "y": y })),
+        "viewport": {
+            "width": inner.as_ref().map(|i| i[0]),
+            "height": inner.as_ref().map(|i| i[1]),
+            "zoom": factor("zoom"),
+            "scale": factor("scale"),
+        },
+    })
+}
