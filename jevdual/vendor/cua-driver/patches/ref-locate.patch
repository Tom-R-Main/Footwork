+        "filmed_point": { "x": 104.5, "y": 105.0 }, "session": SESSION,
+    });
+    for (key, value) in more.as_object().cloned().unwrap_or_default() {
+        args[key] = value;
+    }
+    BrowserClickTool::new(f.engine.clone()).invoke(args).await
+}
