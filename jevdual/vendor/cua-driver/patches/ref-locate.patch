+/// Center of the border quad (the box `getBoundingClientRect` describes), or
+/// of the content quad when the model has no border quad.
+fn border_center(box_model: &Value) -> Option<(f64, f64)> {
+    quad_center_of(box_model, "border").or_else(|| quad_center_of(box_model, "content"))
+}
