+#[tokio::test]
+async fn locate_ref_reports_where_the_element_is_and_changes_nothing() {
+    let f = fixture().await;
+    let (target, tab) = bind(&f).await;
+    let snap = snapshot(&f, &target, &tab).await;
+    let main_ref = ref_of(&snap, "main", "main-btn");
+    let snapshots_before = recorded_calls(&f, "DOMSnapshot.captureSnapshot").len()
+        + recorded_calls(&f, "DOM.getDocument").len();
+
+    let result = locate(&f, &target, &tab, &main_ref).await;
+
+    let reply = structured(&result);
+    assert_eq!(reply["status"], "ok", "{reply}");
+    assert_eq!(reply["mode"], "locate", "{reply}");
+    assert_eq!(reply["ref"], main_ref.as_str(), "{reply}");
+    let found = &reply["locate"];
+    assert_eq!(found["available"], true, "{reply}");
+    assert_eq!(
+        found["rect"],
+        json!({ "x": 100.0, "y": 100.0, "width": 20.0, "height": 10.0 })
+    );
+    assert_eq!(found["center"], json!({ "x": 110.0, "y": 105.0 }));
+    assert_eq!(found["hit"], "target");
+    // the mock's box model for this node has the same centre, read without page script
+    assert_eq!(found["box_center"], json!({ "x": 110.0, "y": 105.0 }));
+    assert_eq!(
+        found["viewport"],
+        json!({ "width": 800.0, "height": 600.0, "zoom": 1.0, "scale": 1.0 })
+    );
+    assert_eq!(found["clipped"], false, "{reply}");
+    assert_eq!(found["visibility_state"], "visible", "{reply}");
+    assert!(
+        found["point"].is_null(),
+        "no point was asked about: {reply}"
+    );
+    assert!(!sent_any_event(&f), "a locate sends no event");
+    assert!(recorded_calls(&f, "DOM.scrollIntoViewIfNeeded").is_empty());
+    assert!(recorded_calls(&f, "DOM.focus").is_empty());
+    assert_eq!(
+        recorded_calls(&f, "DOMSnapshot.captureSnapshot").len()
+            + recorded_calls(&f, "DOM.getDocument").len(),
+        snapshots_before,
+        "a locate takes no snapshot"
+    );
+    {
+        let state = f.state.lock().unwrap();
+        assert!(!state.dom_click_focused);
+        assert_eq!(state.dom_click_generation, 0);
+    }
+    // the ref it located is still current: the click it precedes goes through
+    let clicked = BrowserClickTool::new(f.engine.clone())
+        .invoke(json!({
+            "target_id": target, "tab_id": tab, "ref": main_ref,
+            "input_route": "dom_event", "session": SESSION,
+        }))
+        .await;
+    assert_ne!(clicked.is_error, Some(true), "{}", result_text(&clicked));
+    assert!(sent_any_event(&f));
+}
