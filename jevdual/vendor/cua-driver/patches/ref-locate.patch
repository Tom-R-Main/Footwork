+/// Where the ref's node is, evaluated ON the node with the click sequence's
+/// own geometry: its bounding rectangle in viewport CSS px and what
+/// `elementFromPoint` finds at its centre, and at (`px`, `py`) when both are
+/// numbers.
+///
+/// `clipped` is whether an ancestor that clips or scrolls its overflow
+/// leaves part of the rectangle outside its padding box: such a node is
+/// what `DOM.scrollIntoViewIfNeeded` and `focus()` scroll. The walk follows
+/// the flat tree (an assigned slot, then the parent, then a shadow host). The
+/// root element is skipped: its overflow applies to the viewport, which the
+/// rectangle and `inner` already describe. `body` is skipped only when its
+/// overflow propagates to the viewport too, that is when the root's overflow
+/// is `visible` and neither element has containment; otherwise it is a
+/// scroller like any other. Every other ancestor is tested whether or not
+/// it is the node's containing block, so a fixed or absolutely positioned
+/// node outside a clipping ancestor's box reads as clipped: the error is on
+/// the side of saying so. An ancestor's padding box is scaled by the ratio of
+/// its bounding rectangle to its layout size, which is exact only for
+/// translation and scaling: `transformed` is true when the node or any
+/// ancestor is rotated, skewed or transformed in 3D, and the caller then
+/// reports no position at all.
+const DOM_NODE_LOCATE: &str = "function(px, py) { \
+    const node = this; \
+    const doc = node.ownerDocument, view = doc.defaultView; \
+    const r = node.getBoundingClientRect(); \
+    const x = r.left + r.width / 2, y = r.top + r.height / 2; \
+    const root = node.getRootNode(); \
+    const probe = (qx, qy) => { \
+        const at = ('elementFromPoint' in root) ? root.elementFromPoint(qx, qy) : null; \
+        return !at ? 'none' : (at === node ? 'target' : (node.contains(at) ? 'descendant' : 'other')); \
+    }; \
+    const up = (el) => el.assignedSlot || el.parentElement || (el.getRootNode().host || null); \
+    const shows = (style) => style.overflowX === 'visible' && style.overflowY === 'visible'; \
+    const free = (style) => (style.contain || 'none') === 'none' \
+        && (style.containerType || 'normal') === 'normal' \
+        && (style.contentVisibility || 'visible') === 'visible'; \
+    const turned = (style) => { \
+        if ((style.rotate || 'none') !== 'none') return true; \
+        const t = style.transform || 'none'; \
+        if (t === 'none') return false; \
+        if (!t.startsWith('matrix(')) return true; \
+        const m = t.slice(7, -1).split(',').map(Number); \
+        return !(Math.abs(m[1]) < 1e-6 && Math.abs(m[2]) < 1e-6); \
+    }; \
+    const rootStyle = view.getComputedStyle(doc.documentElement); \
+    const bodyIsViewport = !!doc.body && shows(rootStyle) && free(rootStyle) \
+        && free(view.getComputedStyle(doc.body)); \
+    let clipped = false, transformed = turned(view.getComputedStyle(node)); \
+    for (let el = up(node); el; el = up(el)) { \
+        const style = view.getComputedStyle(el); \
+        if (turned(style)) transformed = true; \
+        if (clipped || el === doc.documentElement) continue; \
+        if (el === doc.body && bodyIsViewport) continue; \
+        if (shows(style)) continue; \
+        const b = el.getBoundingClientRect(); \
+        let left = b.left, top = b.top, width = b.width, height = b.height; \
+        if (typeof el.offsetWidth === 'number' && el.offsetWidth > 0 && el.offsetHeight > 0) { \
+            const sx = b.width / el.offsetWidth, sy = b.height / el.offsetHeight; \
+            left += el.clientLeft * sx; top += el.clientTop * sy; \
+            width = el.clientWidth * sx; height = el.clientHeight * sy; \
+        } \
+        clipped = r.left < left - 0.5 || r.top < top - 0.5 \
+            || r.right > left + width + 0.5 || r.bottom > top + height + 0.5; \
+    } \
+    const point = (typeof px === 'number' && typeof py === 'number') ? [px, py, probe(px, py)] : null; \
+    return { rect: [r.left, r.top, r.width, r.height], hit: probe(x, y), \
+        inner: [view.innerWidth, view.innerHeight], clipped, transformed, \
+        visibility: doc.visibilityState, point }; \
+}";
+
+/// The `locate` block of `get_browser_state`'s locate mode from the locate
+/// script's reply, the box model's centre and the layout metrics. Anything
+/// but a well-formed reply with a positive-area rectangle is unavailable,
+/// and so is a node the script found under a rotation, skew or 3D transform;
+/// the box-model centre, the viewport's zoom and scale, `clipped`,
+/// `visibility_state` and `point` are `null` when they could not be read or
+/// were not asked for, for the caller to refuse on.
+fn dom_locate_value(
+    located: Option<&Value>,
+    box_center: Option<(f64, f64)>,
+    metrics: Option<&Value>,
+) -> Value {
+    let unavailable = |reason: &str| json!({ "available": false, "reason": reason });
+    let Some(reply) = located else {
+        return unavailable("unreadable");
+    };
+    if reply.get("exceptionDetails").is_some() {
+        return unavailable("unreadable");
+    }
+    let Some(value) = reply.pointer("/result/value") else {
+        return unavailable("unreadable");
+    };
+    let numbers = |field: &str, len: usize| -> Option<Vec<f64>> {
+        let items = value.get(field)?.as_array()?;
+        let numbers: Vec<f64> = items
+            .iter()
+            .filter_map(Value::as_f64)
+            .filter(|n| n.is_finite())
+            .collect();
+        (items.len() == len && numbers.len() == len).then_some(numbers)
+    };
+    let Some(rect) = numbers("rect", 4) else {
+        return unavailable("unreadable");
+    };
+    let hit = match value.get("hit").and_then(Value::as_str) {
+        Some(hit @ ("target" | "descendant" | "other" | "none")) => hit,
+        _ => return unavailable("unreadable"),
+    };
+    if rect[2] <= 0.0 || rect[3] <= 0.0 {
+        return unavailable("no_box");
+    }
+    if value.get("transformed").and_then(Value::as_bool) == Some(true) {
+        // the clip test's geometry holds only for translation and scaling
+        return unavailable("transformed");
+    }
+    let inner = numbers("inner", 2);
+    let point = value
+        .get("point")
+        .and_then(Value::as_array)
+        .filter(|point| point.len() == 3)
+        .and_then(|point| {
+            let x = point[0].as_f64().filter(|n| n.is_finite())?;
+            let y = point[1].as_f64().filter(|n| n.is_finite())?;
+            match point[2].as_str()? {
+                hit @ ("target" | "descendant" | "other" | "none") => {
+                    Some(json!({ "x": x, "y": y, "hit": hit }))
+                }
+                _ => None,
+            }
+        });
+    let viewport = metrics.and_then(|m| m.get("cssVisualViewport"));
+    let factor = |field: &str| {
+        viewport
+            .and_then(|v| v.get(field))
+            .and_then(Value::as_f64)
+            .filter(|n| n.is_finite())
+    };
+    json!({
+        "available": true,
+        "rect": { "x": rect[0], "y": rect[1], "width": rect[2], "height": rect[3] },
+        "center": { "x": rect[0] + rect[2] / 2.0, "y": rect[1] + rect[3] / 2.0 },
+        "hit": hit,
+        "box_center": box_center.map(|(x, y)| json!({ "x": x, "y": y })),
+        "viewport": {
+            "width": inner.as_ref().map(|i| i[0]),
+            "height": inner.as_ref().map(|i| i[1]),
+            "zoom": factor("zoom"),
+            "scale": factor("scale"),
+        },
+        "clipped": value.get("clipped").and_then(Value::as_bool),
+        "visibility_state": value.get("visibility").and_then(Value::as_str),
+        "point": point,
+    })
+}
