+/// The execution context the mock gives the locate's isolated world.
+const ISOLATED_CONTEXT: i64 = 77;
+
+/// Every page function run since `from`, as (object id, declaration, arguments).
+fn functions_since(f: &Fixture, from: usize) -> Vec<(String, String, Value)> {
+    recorded_calls(f, "Runtime.callFunctionOn")[from..]
+        .iter()
+        .map(|(_, params)| {
+            (
+                params["objectId"].as_str().unwrap_or_default().to_owned(),
+                params["functionDeclaration"]
+                    .as_str()
+                    .unwrap_or_default()
+                    .to_owned(),
+                params["arguments"].clone(),
+            )
+        })
+        .collect()
+}
