+/// Where one current ref's element is, for `get_browser_state`'s locate
+/// mode. It proves the binding and the ref's document as a click does and
+/// refuses a stale or removed node the same way, then only reads: the
+/// node's rectangle and the hit test at its centre (page script on the
+/// node, the click sequence's own geometry), whether a clipping ancestor
+/// hides part of it, its document's visibility state, the hit test at
+/// `point` when one is given, the border-box centre from `DOM.getBoxModel`,
+/// and the viewport's zoom and scale. Nothing is scrolled, focused or
+/// dispatched.
+async fn locate_browser_ref(
+    engine: &Arc<BrowserEngine>,
+    session: &str,
+    target_id: &str,
+    tab_id: &str,
+    ext_ref: &str,
+    point: Option<(f64, f64)>,
+) -> Result<Value, BrowserRefusal> {
+    let validated = engine
+        .revalidate_for_mutation(session, target_id, Some(tab_id))
+        .await?;
+    // A page-owned dialog blocks the renderer; every read below would wait
+    // out its timeout.
+    if let Some(open) = validated
+        .conn
+        .dialog_state(validated.tab.cdp_target_id.as_str())
+    {
+        return Err(BrowserRefusal::new(
+            BrowserRefusalCode::BrowserActionUnavailable,
+            format!(
+                "a {} dialog is open on the exact tab; the page cannot be read until it is resolved",
+                open.kind
+            ),
+        )
+        .with_detail(json!({ "dialog": dialog_block(&open) })));
+    }
+    let entry = engine
+        .store
+        .resolve_ref(session, target_id, tab_id, ext_ref)?;
+    if entry.frame.kind != FrameKind::Main {
+        // The node's rectangle is relative to its own frame's viewport, not
+        // the tab's.
+        return Ok(json!({ "available": false, "reason": "child_frame" }));
+    }
+    let cdp_session = engine
+        .frame_session_for_mutation(session, target_id, tab_id, &validated, &entry.frame)
+        .await?;
+    let conn = &validated.conn;
+    let cdp = cdp_session.as_str();
+    let backend = entry.backend_node_id;
+    let stale = |message: &str| BrowserRefusal::new(BrowserRefusalCode::BrowserRefStale, message);
+    let resolved = conn
+        .call(
+            Some(cdp),
+            "DOM.resolveNode",
+            json!({ "backendNodeId": backend }),
+        )
+        .await
+        .map_err(|_| stale("the ref's node no longer resolves in the live page"))?;
+    let object_id = resolved
+        .get("object")
+        .and_then(|o| o.get("objectId"))
+        .and_then(Value::as_str)
+        .ok_or_else(|| stale("the ref's node has no live object in the page"))?
+        .to_owned();
+    let on_node = |declaration: &'static str, arguments: Value| {
+        let call = conn.call(
+            Some(cdp),
+            "Runtime.callFunctionOn",
+            json!({
+                "objectId": object_id,
+                "functionDeclaration": declaration,
+                "arguments": arguments,
+                "returnByValue": true,
+            }),
+        );
+        async move {
+            tokio::time::timeout(DOM_CLICK_BASELINE_DEADLINE, call)
+                .await
+                .ok()
+                .and_then(Result::ok)
+        }
+    };
+    let connected = on_node(DOM_NODE_CONNECTED_CHECK, json!([]))
+        .await
+        .and_then(|reply| reply.pointer("/result/value").and_then(Value::as_bool));
+    if connected != Some(true) {
+        return Err(stale(if connected == Some(false) {
+            "the ref's node is no longer in its document"
+        } else {
+            "the ref's node could not be confirmed in its document"
+        }));
+    }
+    let asked = match point {
+        Some((x, y)) => json!([{ "value": x }, { "value": y }]),
+        None => json!([]),
+    };
+    let located = on_node(DOM_NODE_LOCATE, asked).await;
+    let box_center = conn
+        .call(
+            Some(cdp),
+            "DOM.getBoxModel",
+            json!({ "backendNodeId": backend }),
+        )
+        .await
+        .ok()
+        .as_ref()
+        .and_then(border_center);
+    let metrics = conn
+        .call(Some(cdp), "Page.getLayoutMetrics", json!({}))
+        .await
+        .ok();
+    Ok(dom_locate_value(
+        located.as_ref(),
+        box_center,
+        metrics.as_ref(),
+    ))
+}
