+#[tokio::test]
+async fn dom_event_click_refuses_a_node_removed_from_its_document() {
+    let f = fixture_with(|state| state.dom_click_node_detached = true).await;
+    let (target, tab) = bind(&f).await;
+    let snap = snapshot(&f, &target, &tab).await;
+    let main_ref = ref_of(&snap, "main", "main-btn");
+
+    let result = BrowserClickTool::new(f.engine.clone())
+        .invoke(json!({
+            "target_id": target,
+            "tab_id": tab,
+            "ref": main_ref,
+            "input_route": "dom_event",
+            "session": SESSION,
+        }))
+        .await;
+
+    let refused = structured(&result);
+    assert_eq!(refused["refusal"]["code"], "browser_ref_stale", "{refused}");
+    let dispatched_sequence = recorded_calls(&f, "Runtime.callFunctionOn")
+        .iter()
+        .filter_map(|(_, params)| params["functionDeclaration"].as_str().map(str::to_owned))
+        .any(|declaration| declaration.contains("'pointerdown'"));
+    assert!(
+        !dispatched_sequence,
+        "a removed node must receive no events"
+    );
+    let state = f.state.lock().unwrap();
+    assert!(!state.dom_click_focused);
+    assert_eq!(state.dom_click_generation, 0);
+    drop(state);
+    assert!(recorded_calls(&f, "Input.dispatchMouseEvent").is_empty());
+}
+
+#[tokio::test]
+async fn dom_event_click_checks_its_node_is_connected_before_any_event() {
+    let f = fixture().await;
+    let (target, tab) = bind(&f).await;
+    let snap = snapshot(&f, &target, &tab).await;
+    let main_ref = ref_of(&snap, "main", "main-btn");
+
+    BrowserClickTool::new(f.engine.clone())
+        .invoke(json!({
+            "target_id": target,
+            "tab_id": tab,
+            "ref": main_ref,
+            "input_route": "dom_event",
+            "session": SESSION,
+        }))
+        .await;
+
+    let declarations: Vec<String> = recorded_calls(&f, "Runtime.callFunctionOn")
+        .iter()
+        .filter_map(|(_, params)| params["functionDeclaration"].as_str().map(str::to_owned))
+        .collect();
+    let checked = declarations
+        .iter()
+        .position(|declaration| declaration.contains("isConnected"))
+        .expect("the click reads its node's isConnected");
+    let clicked = declarations
+        .iter()
+        .position(|declaration| declaration.contains("'pointerdown'"))
+        .expect("a connected node is clicked");
+    assert!(checked < clicked, "{declarations:?}");
+    assert_eq!(f.state.lock().unwrap().dom_click_generation, 1);
 }
 
