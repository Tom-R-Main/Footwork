+    assert!(text.contains(reason), "{text}");
+    assert!(!text.contains("confirmed"), "{text}");
+    let record = result
+        .action_record
+        .as_ref()
+        .expect("typed browser click action record");
+    assert_eq!(
+        record.effect,
+        crate::action_record::ActionEffect::Unverifiable
+    );
+    assert!(record.evidence.is_empty(), "{record:?}");
+    assert!(
+        result
+            .structured_content
+            .as_ref()
+            .map_or(true, |structured| structured["refusal"].is_null()),
+        "an interrupted click is not a refusal"
+    );
+    // The page's state changed before the interruption; it must not be read
+    // back as a confirmed click.
+    assert_eq!(f.state.lock().unwrap().dom_click_generation, 1);
+}
