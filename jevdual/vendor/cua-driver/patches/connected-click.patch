+/// What a DOM click sequence's reply says about its delivery. Only a
+/// well-formed receipt counts: an exception, a missing value or any other
+/// shape is an interrupted click, never a completed or an undelivered one.
+#[derive(Debug, PartialEq)]
+enum DomClickReceipt {
+    Completed,
+    Detached { count: u64, last: String },
+    Interrupted(&'static str),
+}
+
+fn dom_click_receipt(reply: &Value) -> DomClickReceipt {
+    if reply.get("exceptionDetails").is_some() {
+        return DomClickReceipt::Interrupted("the sequence threw");
+    }
+    let Some(value) = reply.pointer("/result/value") else {
+        return DomClickReceipt::Interrupted("no completion receipt");
+    };
+    let count = value.get("count").and_then(Value::as_u64);
+    match (
+        value.get("complete").and_then(Value::as_bool),
+        value.get("stopped"),
+        count,
+    ) {
+        (Some(true), Some(Value::Null), Some(_)) => DomClickReceipt::Completed,
+        (Some(false), Some(Value::String(stopped)), Some(count)) if stopped == "detached" => {
+            match value.get("last").and_then(Value::as_str) {
+                Some(last) if count == 0 || !last.is_empty() => DomClickReceipt::Detached {
+                    count,
+                    last: last.to_owned(),
+                },
+                _ => DomClickReceipt::Interrupted("a malformed receipt"),
+            }
+        }
+        _ => DomClickReceipt::Interrupted("a malformed receipt"),
+    }
+}
+
+fn dom_click_stopped_action_record(count: u64, last: &str) -> ActionExecutionRecord {
+    ActionExecutionRecord::builder(
+        ActionEffect::Unverifiable,
+        ActionTransport::BrowserCdpRuntimeFunction,
+        RequestedDelivery::NotApplicable,
+    )
+    .actual_delivery(ActualDelivery::Background)
+    .evidence(ActionEvidence {
+        kind: EvidenceKind::EventReceipt,
+        detail: format!(
+            "the click sequence stopped after {last} because the ref's node left its document; \
+             {count} events sent"
+        ),
+    })
+    .escalation(ActionEscalation {
+        kind: EscalationKind::RefreshPageState,
+        detail: Some("the ref's node left its document during the click".to_owned()),
+    })
+    .build()
+    .expect("DOM click action record must satisfy the stable contract")
 }
 
+fn dom_click_interrupted_action_record(reason: &str) -> ActionExecutionRecord {
+    ActionExecutionRecord::builder(
+        ActionEffect::Unverifiable,
+        ActionTransport::BrowserCdpRuntimeFunction,
+        RequestedDelivery::NotApplicable,
+    )
+    .actual_delivery(ActualDelivery::Background)
+    .escalation(ActionEscalation {
+        kind: EscalationKind::RefreshPageState,
+        detail: Some(format!(
+            "the click sequence did not report completing: {reason}"
+        )),
+    })
+    .build()
+    .expect("DOM click action record must satisfy the stable contract")
+}
