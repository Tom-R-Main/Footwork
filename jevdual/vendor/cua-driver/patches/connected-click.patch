+/// The events a DOM click sequence sent before it stopped because the ref's
+/// node left its document, or `None` when it completed or reported nothing.
+fn dom_click_sequence_stopped(reply: &Value) -> Option<Vec<String>> {
+    let value = reply.pointer("/result/value")?;
+    if value.get("stopped").and_then(Value::as_str) != Some("detached") {
+        return None;
+    }
+    Some(
+        value
+            .get("sent")
+            .and_then(Value::as_array)
+            .map(|sent| {
+                sent.iter()
+                    .filter_map(Value::as_str)
+                    .map(str::to_owned)
+                    .collect()
+            })
+            .unwrap_or_default(),
+    )
+}
+
+fn dom_click_stopped_action_record(sent: &[String]) -> ActionExecutionRecord {
+    ActionExecutionRecord::builder(
+        ActionEffect::Unverifiable,
+        ActionTransport::BrowserCdpRuntimeFunction,
+        RequestedDelivery::NotApplicable,
+    )
+    .actual_delivery(ActualDelivery::Background)
+    .evidence(ActionEvidence {
+        kind: EvidenceKind::EventReceipt,
+        detail: format!(
+            "the click sequence stopped after {} because the ref's node left its document; sent: {}",
+            sent.last().map(String::as_str).unwrap_or("?"),
+            sent.join(", ")
+        ),
+    })
+    .escalation(ActionEscalation {
+        kind: EscalationKind::RefreshPageState,
+        detail: Some("the ref's node left its document during the click".to_owned()),
+    })
+    .build()
+    .expect("DOM click action record must satisfy the stable contract")
 }
 
