+    /// Own session-end work until it has finished dropping its captures.
+    /// These captures may include callbacks into a foreign interpreter.
+    pub fn spawn_cleanup(
+        &self,
+        runtime: &tokio::runtime::Handle,
+        work: impl std::future::Future<Output = ()> + Send + 'static,
+    ) {
+        let task = Arc::new(tokio::sync::Mutex::new(Some(runtime.spawn(work))));
+        self.cleanup_tasks.lock().unwrap().push(task);
+    }
