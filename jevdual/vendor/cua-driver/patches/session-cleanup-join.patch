+    /// Admission must be closed and synchronous end hooks finished first.
+    /// Keep handles in the queue while awaiting: cancelling a drain must not
+    /// detach unfinished work. A later drain can join it.
+    pub async fn drain_cleanup(&self) -> Result<(), &'static str> {
+        let _drain = self.cleanup_drain.lock().await;
+        loop {
+            let tasks = self.cleanup_tasks.lock().unwrap().clone();
+            if tasks.is_empty() { break; }
+            for task in &tasks {
+                let mut slot = task.lock().await;
+                if let Some(handle) = slot.as_mut() {
+                    if handle.await.is_err() {
+                        self.cleanup_failed.store(true, Ordering::Release);
+                    }
+                    slot.take();
+                }
+            }
+            self.cleanup_tasks.lock().unwrap().retain(|task| {
+                !tasks.iter().any(|completed| Arc::ptr_eq(task, completed))
+            });
+        }
+        if self.cleanup_failed.load(Ordering::Acquire) {
+            Err("native session cleanup task failed")
+        } else { Ok(()) }
