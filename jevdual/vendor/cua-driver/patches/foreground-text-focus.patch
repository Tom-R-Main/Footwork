+    #[test]
+    fn foreground_text_verified_focus_dispatches_once_and_refusal_is_structured() {
+        let mut emitted = 0;
+        super::dispatch_text_after_focus(
+            Some(7),
+            true,
+            1,
+            |_| Ok(()),
+            |_| true,
+            |_| {},
+            || {
+                emitted += 1;
+                Ok(())
+            },
+        )
+        .unwrap();
+        assert_eq!(emitted, 1);
