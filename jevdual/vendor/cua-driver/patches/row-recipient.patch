+//! SDK-owned row census and actual-token press. No public raw AX entry point.
+use super::bindings::*;
+use core_foundation::{
+    array::CFArray,
+    base::{CFEqual, CFGetTypeID, CFHash, CFRelease, CFRetain, CFType, CFTypeRef, TCFType},
+    boolean::CFBoolean,
+    string::CFString,
+    url::CFURL,
+};
+use cua_driver_contract::row::{
+    discover_row, dispatch_row, RowBinding, RowGraph, RowNode, RowReceipt,
+};
+use cua_driver_contract::ExpectedRow;
+use std::collections::{BTreeMap, BTreeSet};
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+pub struct OwnedAx(usize);
+impl OwnedAx {
+    unsafe fn retain(p: AXUIElementRef) -> Self {
+        CFRetain(p as CFTypeRef);
+        Self(p as usize)
+    }
+    fn ptr(&self) -> AXUIElementRef {
+        self.0 as AXUIElementRef
+    }
+}
+impl Clone for OwnedAx {
+    fn clone(&self) -> Self {
+        unsafe { Self::retain(self.ptr()) }
+    }
+}
+impl Drop for OwnedAx {
+    fn drop(&mut self) {
+        unsafe { CFRelease(self.ptr() as CFTypeRef) }
+    }
+}
+
+pub struct QualifiedRow {
+    pub binding: RowBinding,
+    pub objects: Arc<Vec<OwnedAx>>,
+}
+struct Capture {
+    objects: Vec<OwnedAx>,
+    buckets: BTreeMap<u64, Vec<usize>>,
+    comparisons: usize,
+    deadline: Instant,
+}
+impl Capture {
+    fn new(seed: &[OwnedAx]) -> Self {
+        let mut c = Self {
+            objects: seed.to_vec(),
+            buckets: BTreeMap::new(),
+            comparisons: 0,
+            deadline: Instant::now() + Duration::from_secs(2),
+        };
+        for (i, el) in c.objects.iter().enumerate() {
+            c.buckets
+                .entry(unsafe { CFHash(el.ptr() as CFTypeRef) as u64 })
+                .or_default()
+                .push(i);
+        }
+        c
+    }
+    fn intern(&mut self, el: AXUIElementRef) -> Result<u64, String> {
+        if el.is_null()
+            || unsafe { CFGetTypeID(el as CFTypeRef) } != unsafe { AXUIElementGetTypeID() }
+        {
+            return Err("row census non-AX reference".into());
+        }
+        if Instant::now() > self.deadline {
+            return Err("row census deadline".into());
+        }
+        let hash = unsafe { CFHash(el as CFTypeRef) as u64 };
+        let bucket = self.buckets.entry(hash).or_default();
+        for i in bucket.iter() {
+            self.comparisons += 1;
+            if self.comparisons > 500_000 {
+                return Err("row census equality budget".into());
+            }
+            if self.objects[*i].ptr() == el
+                || unsafe { CFEqual(self.objects[*i].ptr() as CFTypeRef, el as CFTypeRef) } != 0
+            {
+                return Ok(*i as u64);
+            }
+        }
+        if self.objects.len() >= 4096 {
+            return Err("row reference limit".into());
+        }
+        let id = self.objects.len();
+        self.objects.push(unsafe { OwnedAx::retain(el) });
+        bucket.push(id);
+        Ok(id as u64)
+    }
+    fn element(
+        &mut self,
+        el: AXUIElementRef,
+        key: &str,
+        optional: bool,
+    ) -> Result<Option<u64>, String> {
+        let Some(value) = read(el, key, optional)? else {
+            return Ok(None);
+        };
+        self.intern(value.as_CFTypeRef() as AXUIElementRef)
+            .map(Some)
+    }
+    fn elements(
+        &mut self,
+        el: AXUIElementRef,
+        key: &str,
+        optional: bool,
+    ) -> Result<Option<Vec<u64>>, String> {
+        let Some(value) = read(el, key, optional)? else {
+            return Ok(None);
+        };
+        if value.type_of() != CFArray::<CFType>::type_id() {
+            return Err(format!("{key} is not an array"));
+        }
+        let arr = unsafe { CFArray::<CFType>::wrap_under_get_rule(value.as_CFTypeRef() as _) };
+        if arr.len() > 2048 {
+            return Err(format!("{key} exceeds row census bound"));
+        }
+        let mut ids = Vec::new();
+        for item in arr.iter() {
+            let id = self.intern(item.as_CFTypeRef() as AXUIElementRef)?;
+            if !ids.contains(&id) {
+                ids.push(id);
+            } // CFEqual aliases count once, not by geometry/hash.
+        }
+        Ok(Some(ids))
+    }
+    fn graph(
+        &mut self,
+        window: AXUIElementRef,
+        pid: u32,
+        window_id: u64,
+    ) -> Result<RowGraph, String> {
+        let root = self.intern(window)?;
+        let mut wid = 0;
+        if unsafe { _AXUIElementGetWindow(window, &mut wid) } != 0 || u64::from(wid) != window_id {
+            return Err("row window ID unproven".into());
+        }
+        let mut stack = vec![root];
+        let mut seen = BTreeSet::new();
+        let mut nodes = Vec::new();
+        while let Some(id) = stack.pop() {
+            if !seen.insert(id) {
+                continue;
+            }
+            if nodes.len() >= 2048 || Instant::now() > self.deadline {
+                return Err("row census incomplete".into());
+            }
+            let el = self.objects[id as usize].ptr();
+            let mut owner = 0;
+            if unsafe { AXUIElementGetPid(el, &mut owner) } != 0 || owner as u32 != pid {
+                return Err("row peer PID mismatch".into());
+            }
+            let role = text(el, "AXRole", false)?.ok_or("row peer role missing")?;
+            let parent = if id == root {
+                None
+            } else {
+                self.element(el, "AXParent", false)?
+            };
+            if id != root && self.element(el, "AXWindow", false)? != Some(root) {
+                return Err("row peer window mismatch".into());
+            }
+            let children = self
+                .elements(
+                    el,
+                    "AXChildren",
+                    !matches!(
+                        role.as_str(),
+                        "AXWindow"
+                            | "AXWebArea"
+                            | "AXTable"
+                            | "AXRow"
+                            | "AXColumn"
+                            | "AXCell"
+                            | "AXGroup"
+                    ),
+                )?
+                .unwrap_or_default();
+            stack.extend(children.iter().copied());
+            let name = text(el, "AXTitle", true)?
+                .filter(|s| !s.is_empty())
+                .or(text(el, "AXDescription", true)?)
+                .unwrap_or_default();
+            let value = if matches!(role.as_str(), "AXCell" | "AXStaticText") {
+                text(el, "AXValue", true)?
+            } else {
+                None
+            };
+            let url = if role == "AXWebArea" {
+                text(el, "AXURL", false)?
+            } else {
+                None
+            };
+            let rows = if role == "AXTable" {
+                self.elements(el, "AXRows", false)?
+            } else {
+                None
+            };
+            let columns = if role == "AXTable" {
+                self.elements(el, "AXColumns", false)?
+            } else {
+                None
+            };
+            let header = if role == "AXColumn" {
+                self.element(el, "AXHeader", false)?
+            } else {
+                None
+            };
+            let (enabled, actions) = if matches!(role.as_str(), "AXButton" | "AXPopUpButton") {
+                (boolean(el, "AXEnabled")?, actions(el)?)
+            } else {
+                (None, vec![])
+            };
+            nodes.push(RowNode {
+                id,
+                pid,
+                window_id,
+                role,
+                name,
+                value,
+                url,
+                parent,
+                children,
+                rows,
+                columns,
+                header,
+                enabled,
+                actions,
+                error: None,
+            });
+        }
+        Ok(RowGraph {
+            root,
+            nodes,
+            complete: true,
+        })
+    }
+}
+fn read(el: AXUIElementRef, key: &str, optional: bool) -> Result<Option<CFType>, String> {
+    let key_cf = CFString::new(key);
+    let mut value = std::ptr::null();
+    let error =
+        unsafe { AXUIElementCopyAttributeValue(el, key_cf.as_concrete_TypeRef(), &mut value) };
+    if error != 0 {
+        if !value.is_null() {
+            unsafe { CFRelease(value) };
+        }
+        if optional && (error == kAXErrorNoValue || error == kAXErrorAttributeUnsupported) {
+            return Ok(None);
+        }
+        return Err(format!("{key} unreadable ({error})"));
+    }
+    if value.is_null() {
+        return Err(format!("{key} null success"));
+    }
+    Ok(Some(unsafe { CFType::wrap_under_create_rule(value) }))
+}
+fn text(el: AXUIElementRef, key: &str, optional: bool) -> Result<Option<String>, String> {
+    let Some(value) = read(el, key, optional)? else {
+        return Ok(None);
+    };
+    let result = if value.type_of() == CFString::type_id() {
+        unsafe { CFString::wrap_under_get_rule(value.as_CFTypeRef() as _) }.to_string()
+    } else if key == "AXURL" && value.type_of() == CFURL::type_id() {
+        unsafe { CFURL::wrap_under_get_rule(value.as_CFTypeRef() as _) }
+            .get_string()
+            .to_string()
+    } else {
+        return Err(format!("{key} has unsupported text type"));
+    };
+    if result.len() > 2048 {
+        return Err(format!("{key} exceeds text bound"));
+    }
+    Ok(Some(result))
+}
+fn boolean(el: AXUIElementRef, key: &str) -> Result<Option<bool>, String> {
+    let value = read(el, key, false)?.ok_or("enabled missing")?;
+    if value.type_of() != CFBoolean::type_id() {
+        return Err("enabled type invalid".into());
+    }
+    Ok(Some(bool::from(unsafe {
+        CFBoolean::wrap_under_get_rule(value.as_CFTypeRef() as _)
+    })))
+}
+fn actions(el: AXUIElementRef) -> Result<Vec<String>, String> {
+    let mut names = std::ptr::null();
+    let error = unsafe { AXUIElementCopyActionNames(el, &mut names) };
+    if error != 0 || names.is_null() {
+        if !names.is_null() {
+            unsafe { CFRelease(names as _) };
+        }
+        return Err("row actions unreadable".into());
+    }
+    let value = unsafe { CFType::wrap_under_create_rule(names as _) };
+    if value.type_of() != CFArray::<CFType>::type_id() {
+        return Err("row actions wrong type".into());
+    }
+    let arr = unsafe { CFArray::<CFType>::wrap_under_get_rule(value.as_CFTypeRef() as _) };
+    if arr.len() > 64 {
+        return Err("row actions exceed bound".into());
+    }
+    arr.iter()
+        .map(|v| {
+            if v.type_of() != CFString::type_id() {
+                return Err("row action name unreadable".into());
+            }
+            Ok(unsafe { CFString::wrap_under_get_rule(v.as_CFTypeRef() as _) }.to_string())
+        })
+        .collect()
+}
+
+pub fn qualify_snapshot(
+    nodes: &[super::tree::AXNode],
+    pid: u32,
+    window_id: u64,
+) -> BTreeMap<usize, Arc<QualifiedRow>> {
+    let mut qualified = BTreeMap::new();
+    let Some(first) = nodes.iter().find(|n| {
+        n.element_index.is_some()
+            && n.in_web_content
+            && matches!(n.role.as_str(), "AXButton" | "AXPopUpButton")
+    }) else {
+        return qualified;
+    };
+    let Ok(Some(win)) = read(first.element_ptr as AXUIElementRef, "AXWindow", false) else {
+        return qualified;
+    };
+    if win.type_of() != unsafe { AXUIElementGetTypeID() } {
+        return qualified;
+    }
+    let mut capture = Capture::new(&[]);
+    let Ok(graph) = capture.graph(win.as_CFTypeRef() as AXUIElementRef, pid, window_id) else {
+        return qualified;
+    };
+    let mut bindings = Vec::new();
+    for n in nodes.iter().filter(|n| {
+        n.element_index.is_some()
+            && n.in_web_content
+            && matches!(n.role.as_str(), "AXButton" | "AXPopUpButton")
+    }) {
+        let Ok(id) = capture.intern(n.element_ptr as AXUIElementRef) else {
+            return BTreeMap::new();
+        };
+        if let Ok(binding) = discover_row(&graph, pid, window_id, id) {
+            bindings.push((n.element_index.unwrap(), binding));
+        }
+    }
+    let objects = Arc::new(capture.objects);
+    for (id, binding) in bindings {
+        qualified.insert(
+            id,
+            Arc::new(QualifiedRow {
+                binding,
+                objects: objects.clone(),
+            }),
+        );
+    }
+    qualified
+}
+
+pub fn press(
+    qualified: &QualifiedRow,
+    recipient: usize,
+    expected: Option<&ExpectedRow>,
+    pid: u32,
+    wid: u64,
+) -> RowReceipt {
+    let mut capture = Capture::new(&qualified.objects);
+    let graph = (|| {
+        let id = capture.intern(recipient as AXUIElementRef)?;
+        if id != qualified.binding.recipient {
+            return Err("actual SDK token differs from row recipient".into());
+        }
+        let win = read(recipient as AXUIElementRef, "AXWindow", false)?
+            .ok_or("recipient window absent")?;
+        capture.graph(win.as_CFTypeRef() as AXUIElementRef, pid, wid)
+    })();
+    dispatch_row(
+        graph,
+        &qualified.binding,
+        expected,
+        pid,
+        wid,
+        qualified.binding.recipient,
+        || {
+            if crate::apps::frontmost_pid() != Some(pid as i32) {
+                return Err("row recipient app no longer foreground".into());
+            }
+            let raw_app = unsafe { AXUIElementCreateApplication(pid as i32) };
+            if raw_app.is_null() {
+                return Err("row foreground app unreadable".into());
+            }
