+        "Qualified row AXPress attempted; acknowledgement does not prove the menu or application effect. Do not retry without readback."
+    } else { "Qualified row refused before AXPress; no input attempted." };
+    ToolResult::text(summary).with_structured(serde_json::json!({"row_receipt": receipt})).with_action_record(record)
