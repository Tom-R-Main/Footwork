+#[tokio::test]
+async fn semantic_snapshot_reports_a_viewport_rect_only_for_main_frame_refs_in_view() {
+    let f = fixture_with(|st| st.semantic_large_page = true).await;
+    let (target, tab) = bind(&f).await;
+    let snap = semantic_snapshot(&f, &target, &tab).await;
+
+    let refs = snap["refs"].as_array().expect("refs");
+    let mut located = 0;
+    for entry in refs {
+        let rect = entry
+            .get("rect")
+            .unwrap_or_else(|| panic!("every ref carries rect: {entry}"));
+        if entry["frame"] == "main" && entry["visibility"] == "in_viewport" {
+            for key in ["x", "y", "width", "height"] {
+                assert!(rect[key].is_f64() || rect[key].is_u64(), "{entry}");
+            }
+            assert!(rect["width"].as_f64().unwrap() > 0.0, "{entry}");
+            assert!(rect["height"].as_f64().unwrap() > 0.0, "{entry}");
+            located += 1;
+        } else {
+            assert!(rect.is_null(), "{entry}");
+        }
+    }
+    assert!(located > 0, "{snap}");
 }
 
 #[tokio::test]
